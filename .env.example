# From https://app.photon.codes -> your project -> Settings
PROJECT_ID=
PROJECT_SECRET=

# Printed once when you register the webhook (see README). Save it immediately.
SPECTRUM_SIGNING_SECRET=

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# OPTIONAL — use an Anthropic-API-compatible gateway instead of the official
# API (AgentRouter, OpenRouter, LiteLLM, a self-hosted proxy...). Leave blank
# for api.anthropic.com. ANTHROPIC_API_KEY above then holds the GATEWAY's key.
#
# Gateways vary in whether they proxy tool use and vision — ECHO needs both.
# Run `bun run doctor` after setting this to check before you rely on it.
# Set ANTHROPIC_MODEL to whatever the gateway calls the model you want.
ANTHROPIC_BASE_URL=

# How YOUR iMessage identifies you: a phone number in E.164 (+14155551234) OR
# your Apple ID email — iMessage supports both. ECHO only treats messages from
# this address, in its own DM, as commands; everything else it sees (group
# chats it's been added to) is ingested as context but not replied to.
# Optional: run the high-volume extraction path (runs on EVERY inbound
# message) on a cheaper/faster model than the user-facing agents.
LLM_EXTRACTION_MODEL=

PRIMARY_USER_ADDRESS=you@example.com

# Public HTTPS base URL this server is reachable at (ngrok while developing,
# your real deploy URL once shipped). Used for the live knowledge-graph card.
PUBLIC_BASE_URL=https://your-tunnel-or-deploy-url.example.com

PORT=3000

# Path to the SQLite file. Fine to leave as-is.
DATABASE_PATH=./data/echo.sqlite

# ---- Voice mode (OPTIONAL) ----
# Claude's API is text+vision only, so speech needs a separate provider.
# Leave VOICE_API_KEY blank and ECHO works normally, just without voice:
# inbound voice memos get acknowledged instead of transcribed, replies stay
# text-only. Set it and you can send voice memos, get spoken replies, and
# use "speak <any command>".
# Default provider is OpenAI (one key covers both Whisper STT and TTS):
# https://platform.openai.com/api-keys
VOICE_API_KEY=
VOICE_STT_MODEL=whisper-1
VOICE_TTS_MODEL=tts-1
VOICE_TTS_VOICE=nova

# Render runs UTC; dates render in this zone instead so a "due Friday" never
# shows as the wrong day. IANA name (e.g. Africa/Lagos, America/New_York).
DISPLAY_TIMEZONE=UTC
